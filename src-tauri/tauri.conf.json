{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreeShow Rust",
  "version": "0.1.0",
  "identifier": "app.freeshow.rust",
  "build": {
    "beforeDevCommand": "npm run rust:frontend:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run rust:frontend:build",
    "frontendDist": "../dist-rust"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "FreeShow Rust — development", "width": 1280, "height": 800, "minWidth": 800, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "resources": { "../dist-rust/remotes/": "remotes/" },
    "icon": ["../public/512x512.png", "../public/icon.ico", "../public/icon.icns"]
  }
}
